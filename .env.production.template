# =============================================================
# .env.production — Environment variables for production server
# Copy this to your EC2 instance as ".env" in the app directory
# NEVER commit this file with real values to git!
# =============================================================

# Spring Boot profile
SPRING_PROFILES_ACTIVE=prod

# JWT secret — CHANGE THIS to a long random string (min 32 chars)
# Generate one: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_STRING_HERE

# CORS — set to your actual domain(s)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# H2 Database credentials (default sa/empty is fine for H2)
DB_USER=sa
DB_PASSWORD=

# S3 Bucket name for database backups
S3_BUCKET=nihongocards-backup

# AWS Region (for backup script)
AWS_REGION=ap-southeast-1
